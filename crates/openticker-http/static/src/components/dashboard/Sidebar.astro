---
import { navItems } from "../../lib/dashboard/pages";

const { currentPage = "overview" } = Astro.props;
const activePage = currentPage === "bot-detail"
  ? "bots"
  : currentPage === "feed-detail"
    ? "feeds"
    : currentPage === "cycles-detail"
      ? "cycles"
    : currentPage;
---

<aside class="sidebar panel">
  <div class="brand-block">
    <p class="eyebrow">OpenTicker</p>
    <h1 class="page-heading" style="font-size:1.85rem;">Control Workspace</h1>
    <p class="brand-copy">White-mode operator surface for runtime supervision, execution flow, connector resilience, and API coverage.</p>
  </div>

  <nav class="nav-stack" aria-label="Workspace navigation">
    {navItems.map((item) => (
      <a
        href={item.href}
        class={`nav-button ${activePage === item.id ? "active" : ""}`}
        data-page-target={item.id}
      >
        {item.label}
      </a>
    ))}
  </nav>

  <section class="rail-section">
    <h2 class="rail-title">Global Controls</h2>
    <div class="button-grid">
      <button type="button" class="toolbar-button primary" id="refresh-btn" data-busy-lock>Refresh</button>
      <button type="button" class="toolbar-button" id="reload-btn" data-busy-lock>Reload Config</button>
      <button type="button" class="toolbar-button danger" id="kill-on-btn" data-busy-lock>Kill Switch On</button>
      <button type="button" class="toolbar-button warning" id="kill-off-btn" data-busy-lock>Clear Kill Switch</button>
    </div>
    <label class="toggle-row">
      <input id="auto-refresh" type="checkbox" checked>
      <span>Auto refresh every 5s</span>
    </label>
  </section>

  <section class="rail-section">
    <h2 class="rail-title">Always Visible</h2>
    <div class="sidebar-stat-grid">
      <div class="stat-box"><span>Ready</span><strong id="sidebar-ready">-</strong></div>
      <div class="stat-box"><span>Mode</span><strong id="sidebar-mode">-</strong></div>
      <div class="stat-box"><span>Bots</span><strong id="sidebar-instances">-</strong></div>
      <div class="stat-box"><span>Running</span><strong id="sidebar-running">-</strong></div>
      <div class="stat-box"><span>Connectors</span><strong id="sidebar-connectors">-</strong></div>
      <div class="stat-box"><span>Focused</span><strong id="sidebar-focus">none</strong></div>
    </div>
    <div class="focus-pill-row">
      <span id="mode-chip" class="badge">Mode Unknown</span>
      <span id="service-chip" class="badge">Service Unknown</span>
      <span id="config-chip" class="badge">Config Unknown</span>
    </div>
    <div id="clock-utc" class="badge info">--:--:-- UTC</div>
  </section>

  <section class="rail-section">
    <h2 class="rail-title">Watchlist</h2>
    <ul id="watchlist-list" class="watchlist"></ul>
  </section>
</aside>
