---
const { currentPage = "overview" } = Astro.props;
const isActive = currentPage === "bots";
---

<section class={`workspace-page ${isActive ? "active" : ""}`} data-page="bots" hidden={!isActive}>
  <article class="panel panel-section">
    <div class="panel-head">
      <div>
        <h3>Bot Directory</h3>
        <p>Inspect loaded bots, compare posture and PnL, then open a dedicated bot detail page for lifecycle, reconciliation, and simulation work.</p>
      </div>
      <span id="instances-visible-count" class="badge">0 / 0</span>
    </div>
    <div class="toolbar-row">
      <label class="field-inline">
        <span>Search</span>
        <input id="instance-search" type="text" placeholder="Search by id, ticker, market, or account">
      </label>
    </div>
    <div class="toolbar-row">
      <div class="button-grid" style="grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); width:100%;">
        <button type="button" class="toolbar-button primary" id="bulk-start-btn" data-busy-lock>Start All Bots</button>
        <button type="button" class="toolbar-button danger" id="bulk-stop-btn" data-busy-lock>Stop All Bots</button>
        <button type="button" class="toolbar-button" id="bulk-pause-btn" data-busy-lock>Pause All Running</button>
        <button type="button" class="toolbar-button primary" id="bulk-resume-btn" data-busy-lock>Resume All Paused</button>
        <button type="button" class="toolbar-button warning" id="bulk-reconcile-btn" data-busy-lock>Reconcile All Bots</button>
        <button type="button" class="toolbar-button" id="bulk-tick-btn" data-busy-lock>Tick All Running</button>
        <button type="button" class="toolbar-button warning" id="bulk-cancel-orders-btn" data-busy-lock>Cancel Orders For All</button>
      </div>
      <p class="terminal-note" style="margin:0; max-width:48rem;">
        Bulk actions target every loaded bot, not only the currently filtered rows. Start All skips disabled, blocked, or reconciling bots. Resume and tick only target eligible paused or running bots.
      </p>
    </div>
    <div class="stack">
      <div class="field-block">
        <span>State</span>
        <div class="stream-tabs" id="instance-state-tabs">
          <button type="button" class="stream-tab active" data-instance-state-tab="all" aria-pressed="true">All States</button>
          <button type="button" class="stream-tab" data-instance-state-tab="running" aria-pressed="false">Running</button>
          <button type="button" class="stream-tab" data-instance-state-tab="paused" aria-pressed="false">Paused</button>
          <button type="button" class="stream-tab" data-instance-state-tab="reconciling" aria-pressed="false">Reconciling</button>
          <button type="button" class="stream-tab" data-instance-state-tab="stopped" aria-pressed="false">Stopped</button>
          <button type="button" class="stream-tab" data-instance-state-tab="blocked" aria-pressed="false">Recon Blocked</button>
        </div>
      </div>
      <div class="field-block">
        <span>Market</span>
        <div class="stream-tabs" id="instance-market-tabs">
          <button type="button" class="stream-tab active" data-instance-market-tab="all" aria-pressed="true">All</button>
          <button type="button" class="stream-tab" data-instance-market-tab="equities" aria-pressed="false">Stocks</button>
          <button type="button" class="stream-tab" data-instance-market-tab="crypto" aria-pressed="false">Crypto</button>
        </div>
      </div>
      <div class="field-block">
        <span>Availability</span>
        <div class="stream-tabs" id="instance-enabled-tabs">
          <button type="button" class="stream-tab active" data-instance-enabled-tab="all" aria-pressed="true">All Bots</button>
          <button type="button" class="stream-tab" data-instance-enabled-tab="enabled" aria-pressed="false">Enabled</button>
          <button type="button" class="stream-tab" data-instance-enabled-tab="disabled" aria-pressed="false">Disabled</button>
        </div>
      </div>
    </div>
    <div class="table-wrap bot-directory-table-wrap">
      <table class="bot-directory-table">
        <colgroup>
          <col class="bot-col-bot">
          <col class="bot-col-venue">
          <col class="bot-col-runtime">
          <col class="bot-col-readiness">
          <col class="bot-col-position">
          <col class="bot-col-pnl">
          <col class="bot-col-action">
        </colgroup>
        <thead>
          <tr>
            <th>Bot &amp; Tickers</th>
            <th>Venue</th>
            <th>Runtime</th>
            <th>Readiness</th>
            <th>Position</th>
            <th>PnL</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="instances-body"></tbody>
      </table>
    </div>
  </article>
</section>
