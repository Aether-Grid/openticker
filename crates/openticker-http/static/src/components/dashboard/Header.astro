---
import { pageMeta } from "../../lib/dashboard/pages";

const { currentPage = "overview" } = Astro.props;
const meta = pageMeta[currentPage] ?? pageMeta.overview;
---

<header class="page-header panel">
  <div class="workspace-head">
    <p class="eyebrow">Local Control Plane</p>
    <h2 id="page-title" class="page-heading">{meta.title}</h2>
    <p id="page-description" class="page-description">{meta.description}</p>
    <p id="mode-banner" class="mode-banner">Loading runtime mode...</p>
  </div>
  <div class="header-actions">
    <div class="header-chip-row">
      <span class="badge info">Private Local API</span>
      <span id="connector-summary" class="badge">Connectors Unknown</span>
      <span id="last-updated" class="badge">Not Synced</span>
    </div>
    <div id="flash" class="flash">Waiting for first sync.</div>
  </div>
</header>
