---
const { currentPage = "overview" } = Astro.props;
const isActive = currentPage === "bot-detail";
---

<section class={`workspace-page ${isActive ? "active" : ""}`} data-page="bot-detail" hidden={!isActive}>
  <div class="toolbar-row" style="justify-content:flex-start; margin-bottom:12px;">
    <button type="button" class="toolbar-button" id="bot-detail-back">Back To Bots</button>
  </div>
  <div class="bot-detail-shell">
    <article class="panel panel-section bot-hero-panel">
      <div class="panel-head">
        <div>
          <p class="eyebrow">Bot Performance</p>
          <h3 id="focus-id">none</h3>
          <p id="focus-hero-note" class="panel-copy">Portfolio-style performance and execution view for the selected bot.</p>
        </div>
        <span id="focus-safe-pill" class="badge">No bot selected</span>
      </div>
      <div class="bot-hero-grid">
        <div class="summary-box"><span>State</span><strong id="focus-state">-</strong></div>
        <div class="summary-box"><span>Mode</span><strong id="focus-mode">-</strong></div>
        <div class="summary-box"><span>Account</span><strong id="focus-account">-</strong></div>
        <div class="summary-box"><span>Market</span><strong id="focus-market">-</strong></div>
        <div class="summary-box"><span>Tickers</span><strong id="focus-tickers">-</strong></div>
        <div class="summary-box"><span>Connector</span><strong id="focus-connector">-</strong></div>
        <div class="summary-box"><span>Warmup</span><strong id="focus-warmup">-</strong></div>
        <div class="summary-box"><span>Warmup Error</span><strong id="focus-warmup-error">-</strong></div>
        <div class="summary-box"><span>Account Capacity</span><strong id="focus-account-cap">-</strong></div>
        <div class="summary-box"><span>Account Free</span><strong id="focus-account-free">-</strong></div>
        <div class="summary-box"><span>Bot Allocation</span><strong id="focus-bot-allocated">-</strong></div>
        <div class="summary-box"><span>Bot Tradeable</span><strong id="focus-bot-remaining">-</strong></div>
        <div class="summary-box"><span>Mark</span><strong id="focus-mark-price">-</strong></div>
      </div>
    </article>

    <div class="metric-grid bot-kpi-grid">
      <article class="metric-card"><span>Total P&L</span><strong id="focus-total-pnl">-</strong><p>Realized plus current marked unrealized P&L.</p></article>
      <article class="metric-card"><span>Net Realized</span><strong id="focus-realized-pnl">-</strong><p>Persisted realized P&L carried across restarts.</p></article>
      <article class="metric-card"><span>Current Unrealized</span><strong id="focus-unrealized-pnl">-</strong><p>Mark-to-market using the latest polled bar close.</p></article>
      <article class="metric-card"><span>Open Notional</span><strong id="focus-open-notional">-</strong><p>Current marked exposure for the active position.</p></article>
      <article class="metric-card"><span>Closed Trades</span><strong id="focus-closed-trades">-</strong><p>Derived from recent fill history for this bot.</p></article>
      <article class="metric-card"><span>Win Rate</span><strong id="focus-win-rate">-</strong><p>Share of profitable closes in the sampled trade window.</p></article>
      <article class="metric-card"><span>Biggest Win</span><strong id="focus-biggest-win">-</strong><p>Largest net positive close in the sampled trade window.</p></article>
      <article class="metric-card"><span>Biggest Loss</span><strong id="focus-biggest-loss">-</strong><p>Largest net negative close in the sampled trade window.</p></article>
      <article class="metric-card"><span>Average Hold</span><strong id="focus-avg-hold">-</strong><p>Average time from entry to exit across sampled closes.</p></article>
      <article class="metric-card"><span>Last Poll</span><strong id="focus-last-poll">-</strong><p>Most recent polling result and market data freshness marker.</p></article>
    </div>

    <article class="panel panel-section">
      <div class="panel-head">
        <div>
          <h3>Symbol Lanes</h3>
          <p>Each configured symbol runs in its own lane. Single-symbol operations use the selected lane, while lifecycle and close-all actions still target the whole bot.</p>
        </div>
        <span id="focus-lane-pill" class="badge">No lane selected</span>
      </div>
      <div class="toolbar-row">
        <label class="field-inline">
          <span>Action Symbol</span>
          <select id="focus-lane-select"></select>
        </label>
        <p id="focus-lane-note" class="terminal-note">Open a bot to inspect its per-symbol lanes.</p>
      </div>
      <div id="focus-lane-list" class="lane-grid"></div>
    </article>

    <article class="panel panel-section">
      <div class="panel-head">
        <div>
          <h3>Lane Market Data</h3>
          <p>Compare selected lane dataplane buffer bars against connector history fetched on demand.</p>
        </div>
      </div>
      <div class="grid-two">
        <div>
          <p class="terminal-note" id="focus-lane-buffer-note">Current Buffer (In-Memory)</p>
          <div class="table-wrap">
            <table class="stream-bars-table">
              <thead>
                <tr>
                  <th>Timestamp</th>
                  <th>Open</th>
                  <th>High</th>
                  <th>Low</th>
                  <th>Close</th>
                  <th>Volume</th>
                </tr>
              </thead>
              <tbody id="focus-lane-buffer-body"></tbody>
            </table>
          </div>
        </div>
        <div>
          <p class="terminal-note" id="focus-lane-history-note">Connector History (On Demand)</p>
          <div class="table-wrap">
            <table class="stream-bars-table">
              <thead>
                <tr>
                  <th>Timestamp</th>
                  <th>Open</th>
                  <th>High</th>
                  <th>Low</th>
                  <th>Close</th>
                  <th>Volume</th>
                </tr>
              </thead>
              <tbody id="focus-lane-history-body"></tbody>
            </table>
          </div>
        </div>
      </div>
    </article>

    <div class="grid-two wide-left">
      <article class="panel panel-section">
        <div class="panel-head">
          <div>
            <h3>Current Position</h3>
            <p>Live open-position snapshot, entry context, and marked P&L for the selected bot.</p>
          </div>
        </div>
        <div id="focus-active-position" class="bot-position-host"></div>
      </article>

      <article class="panel panel-section">
        <div class="panel-head">
          <div>
            <h3>Reconciliation Context</h3>
            <p>Latest safety posture and explicit differences from the selected bot reconciliation report.</p>
          </div>
        </div>
        <div class="detail-list">
          <div class="detail-row"><span>Latest Check</span><strong id="focus-check-at">-</strong></div>
          <div class="detail-row"><span>Safe To Trade</span><strong id="focus-safe">-</strong></div>
        </div>
        <p id="focus-reason" class="terminal-note">Open a bot to load reconciliation detail.</p>
        <ul id="focus-differences" class="difference-list"></ul>
      </article>
    </div>

    <div class="grid-two wide-left">
      <article class="panel panel-section activity-records-panel">
        <div class="panel-head">
          <div>
            <h3>Latest Execution Markers</h3>
            <p>Most recent signal-to-execution events seen for this bot in the current dashboard session.</p>
          </div>
          <button type="button" class="toolbar-button" id="focus-open-trace" disabled>Open Latest Trace</button>
        </div>
        <div class="bot-latest-grid">
          <div class="summary-box"><span>Position State</span><strong id="focus-position">-</strong></div>
          <div class="summary-box"><span>Entry Price</span><strong id="focus-entry">-</strong></div>
          <div class="summary-box"><span>Last Eval</span><strong id="focus-last-eval">-</strong></div>
          <div class="summary-box"><span>Last Intent</span><strong id="focus-last-intent">-</strong></div>
          <div class="summary-box"><span>Last Risk</span><strong id="focus-last-risk">-</strong></div>
          <div class="summary-box"><span>Last Order</span><strong id="focus-last-order">-</strong></div>
          <div class="summary-box"><span>Last Fill</span><strong id="focus-last-fill">-</strong></div>
        </div>
      </article>

      <article class="panel panel-section activity-detail-panel">
        <div class="panel-head">
          <div>
            <h3>Control Desk</h3>
            <p>Lifecycle actions and simulation tools for the selected bot.</p>
          </div>
        </div>
        <div class="focus-action-grid" id="focused-actions">
          <button type="button" class="focus-action primary" data-instance-action="start" data-busy-lock>Start</button>
          <button type="button" class="focus-action" data-instance-action="stop" data-busy-lock>Stop</button>
          <button type="button" class="focus-action" data-instance-action="pause" data-busy-lock>Pause</button>
          <button type="button" class="focus-action primary" data-instance-action="resume" data-busy-lock>Resume</button>
          <button type="button" class="focus-action" data-instance-action="tick" data-busy-lock>Tick Once</button>
          <button type="button" class="focus-action" data-instance-action="reconcile" data-busy-lock>Reconcile</button>
          <button type="button" class="focus-action warning" data-instance-action="cancel-open-orders" data-busy-lock>Cancel Orders</button>
          <button type="button" class="focus-action danger" data-instance-action="close-positions" data-busy-lock>Close Positions</button>
        </div>
        <div class="panel-divider"></div>
        <div class="panel-head">
          <div>
            <h4>Simulation Console</h4>
            <p>Inject a synthetic bar or normalized trade straight into the selected bot without waiting for market data.</p>
          </div>
          <span id="simulation-badge" class="badge">Idle</span>
        </div>
        <p class="terminal-note">Focused target: <strong id="simulation-target">none</strong></p>
        <div class="field-grid">
          <label class="field-block">
            <span>Bar Phase</span>
            <select id="sim-bar-phase" data-busy-lock>
              <option value="confirmed" selected>confirmed</option>
              <option value="preview">preview</option>
            </select>
          </label>
          <label class="field-block">
            <span>Bar Timestamp</span>
            <input id="sim-bar-timestamp" type="datetime-local" step="1" data-busy-lock>
          </label>
          <label class="field-block"><span>Open</span><input id="sim-bar-open" type="number" step="0.0001" value="100" data-busy-lock></label>
          <label class="field-block"><span>High</span><input id="sim-bar-high" type="number" step="0.0001" value="101" data-busy-lock></label>
          <label class="field-block"><span>Low</span><input id="sim-bar-low" type="number" step="0.0001" value="99" data-busy-lock></label>
          <label class="field-block"><span>Close</span><input id="sim-bar-close" type="number" step="0.0001" value="100.5" data-busy-lock></label>
          <label class="field-block"><span>Volume</span><input id="sim-bar-volume" type="number" step="0.0001" value="1000" data-busy-lock></label>
          <label class="field-block"><span>Trade Timestamp</span><input id="sim-trade-timestamp" type="datetime-local" step="1" data-busy-lock></label>
          <label class="field-block"><span>Trade Symbol</span><input id="sim-trade-symbol" type="text" value="AAPL" autocomplete="off" data-busy-lock></label>
          <label class="field-block"><span>Trade Price</span><input id="sim-trade-price" type="number" step="0.0001" value="123.45" data-busy-lock></label>
          <label class="field-block"><span>Trade Quantity</span><input id="sim-trade-quantity" type="number" step="0.0001" value="1" data-busy-lock></label>
        </div>
        <div class="button-grid">
          <button type="button" class="toolbar-button primary" id="sim-bar-btn" data-busy-lock>Submit Bar</button>
          <button type="button" class="toolbar-button primary" id="sim-trade-btn" data-busy-lock>Submit Trade</button>
        </div>
        <pre id="simulation-output" class="terminal small">No simulation request sent yet.</pre>
      </article>
    </div>

    <article class="panel panel-section">
      <div class="panel-head">
        <div>
          <h3>Last 25 Trades</h3>
          <p id="focus-trades-note">Derived from recent fills for this bot. Fees are not currently tracked by the runtime journal.</p>
        </div>
        <span id="focus-trades-count" class="badge">0 trades</span>
      </div>
      <div class="table-wrap bot-trades-wrap">
        <table>
          <thead>
            <tr>
              <th>Side</th>
              <th>Entry Time</th>
              <th>Exit Time</th>
              <th>Entry Price</th>
              <th>Exit Price</th>
              <th>Quantity</th>
              <th>Holding Time</th>
              <th>Notional Entry</th>
              <th>Notional Exit</th>
              <th>Net P&amp;L</th>
            </tr>
          </thead>
          <tbody id="focus-trades-body"></tbody>
        </table>
      </div>
    </article>

    <article class="panel panel-section">
      <div class="panel-head">
        <div>
          <h3>Bot Timeline</h3>
          <p>Per-bot timeline for polling, signals, intents, risk outcomes, and execution transitions.</p>
        </div>
        <span id="focus-timeline-count" class="badge">0 / 80</span>
      </div>
      <ul id="focus-timeline-list" class="timeline-list"></ul>
    </article>
  </div>
</section>
