# Connector credentials referenced by config/accounts/*.toml
ALPACA_PAPER_KEY=your_alpaca_paper_api_key
ALPACA_PAPER_SECRET=your_alpaca_paper_api_secret
BINANCE_DEMO_KEY=your_binance_demo_api_key
BINANCE_DEMO_SECRET=your_binance_demo_api_secret

# Logging controls
# Primary tracing filter used by openticker-cli.
OPENTICKER_LOG=openticker_service=debug,openticker_http=info,openticker_signals=debug,warn

# Optional fallback tracing filter used when OPENTICKER_LOG is not set.
RUST_LOG=

# Optional directory for daily-rotated JSON runtime logs.
OPENTICKER_LOG_DIR=var/log

# For additional account profiles, add env vars that match api_key_env,
# api_secret_env, and passphrase_env values in your account TOML files.

# Docker build-time settings
# Enables private indicator support in the openticker-cli build.
OPENTICKER_FEATURES=indicators

# GitHub PAT with read access to the private openticker-indicators repository.
# Set this as a build argument/secret, not a runtime variable.
GITHUB_TOKEN=your_github_pat_with_private_repo_read_access
