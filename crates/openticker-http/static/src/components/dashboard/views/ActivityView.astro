---
import { activityTabs } from "../../../lib/dashboard/pages";

const { currentPage = "overview" } = Astro.props;
const isActive = currentPage === "activity";
---

<section class={`workspace-page ${isActive ? "active" : ""}`} data-page="activity" hidden={!isActive}>
  <article class="panel panel-section">
    <div class="stream-tabs" id="activity-tabs">
      {activityTabs.map((tab) => (
        <button type="button" class={`stream-tab ${tab.id === "positions" ? "active" : ""}`} data-stream-tab={tab.id}>
          {tab.label} <span id={`${tab.id}-count`} class="selection-chip">0</span>
        </button>
      ))}
    </div>
  </article>

  <div class="grid-two wide-left">
    <div class="stack">
      <article class="panel panel-section activity-records-panel">
        <div class="panel-head">
          <div>
            <h3 id="activity-list-title">Positions</h3>
            <p id="activity-list-note">Recent position transitions and flatten reasons from the runtime journal. Use Bot Detail for current position state.</p>
          </div>
          <span id="activity-list-count" class="badge">0 records</span>
        </div>
        <div class="activity-filter-grid">
          <label class="field-block activity-search-field">
            <span>Search</span>
            <input id="activity-search" type="search" placeholder="Search by bot, ticker, kind, reason, or payload detail">
          </label>
          <label class="field-block">
            <span>Bot</span>
            <select id="activity-filter-bot">
              <option value="">All bots</option>
            </select>
          </label>
          <label class="field-block">
            <span>Ticker</span>
            <select id="activity-filter-symbol">
              <option value="">All tickers</option>
            </select>
          </label>
          <label class="field-block">
            <span>Origin</span>
            <select id="activity-filter-origin">
              <option value="">All origins</option>
            </select>
          </label>
          <label class="field-block">
            <span>Window</span>
            <select id="activity-feed-limit">
              <option value="60">60</option>
              <option value="120">120</option>
              <option value="240">240</option>
              <option value="500">500</option>
              <option value="1000">1000</option>
            </select>
          </label>
          <div class="activity-filter-actions">
            <button type="button" class="toolbar-button" id="activity-clear-filters">Clear Filters</button>
          </div>
        </div>
        <p id="activity-filter-note" class="terminal-note">Showing all records in the selected stream.</p>
        <ul id="activity-list" class="activity-list"></ul>
      </article>
    </div>

    <div class="stack">
      <article class="panel panel-section">
        <div class="panel-head">
          <div>
            <h3>Feed Pressure</h3>
            <p>Relative activity volume across every surfaced event feed in the dashboard cache.</p>
          </div>
        </div>
        <div id="activity-summary-chart" class="bar-list"></div>
      </article>

      <article class="panel panel-section">
        <div class="panel-head">
          <div>
            <h3>Activity Context</h3>
            <p>Summary markers for the active stream after applying current filters.</p>
          </div>
        </div>
        <div class="mini-summary">
          <div class="mini-card"><span>Stream</span><strong id="activity-stream-label">-</strong><p>Active feed tab.</p></div>
          <div class="mini-card"><span>Visible</span><strong id="activity-visible-count">-</strong><p>Records visible after search and filters.</p></div>
          <div class="mini-card"><span>Latest</span><strong id="activity-latest-time">-</strong><p>Newest record timestamp in scope.</p></div>
          <div class="mini-card"><span>Focused Hits</span><strong id="activity-focused-count">-</strong><p>Records associated with the currently focused bot.</p></div>
        </div>
      </article>

      <article class="panel panel-section activity-detail-panel">
        <div class="panel-head">
          <div>
            <h3 id="activity-selected-title">Selected Record</h3>
            <p id="activity-selected-note">Choose a record on the left to load contextual detail.</p>
          </div>
          <div class="toolbar-row" style="justify-content:flex-end; gap:8px;">
            <button type="button" class="toolbar-button" id="activity-open-trace" disabled>Open Trace</button>
            <span id="activity-selected-meta" class="badge" data-badge-variant="badge-meta">No selection</span>
          </div>
        </div>
        <div class="activity-selected-grid">
          <div class="detail-row"><span>Stream</span><strong id="activity-selected-stream">-</strong></div>
          <div class="detail-row"><span>Bot</span><strong id="activity-selected-bot">-</strong></div>
          <div class="detail-row"><span>Ticker</span><strong id="activity-selected-symbol">-</strong></div>
          <div class="detail-row"><span>Origin</span><strong id="activity-selected-origin">-</strong></div>
          <div class="detail-row"><span>Record Kind</span><strong id="activity-selected-kind">-</strong></div>
          <div class="detail-row"><span>Account</span><strong id="activity-selected-account">-</strong></div>
        </div>
        <pre id="activity-terminal" class="terminal">Select a record from the active stream to inspect it here.</pre>
      </article>
    </div>
  </div>
</section>
